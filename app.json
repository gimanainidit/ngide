{
  "expo": {
    "name": "Ngide",
    "slug": "ngide-gimanainidit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#f2f5fa"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.ngide",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ngide",
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Ngide butuh mikrofon untuk merekam ide Anda."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f2f5fa",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#f2f5fa"
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "932cdc8a-bc19-4222-80d6-7778911bb497"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/932cdc8a-bc19-4222-80d6-7778911bb497",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "androidStatusBar": {
      "translucent": true
    }
  }
}